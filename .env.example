# ── Database (PostgreSQL) ─────────────────────────────────────
# Local: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cargohs54"

# ── Auth ──────────────────────────────────────────────────────
# Required in production (32+ chars). Generate: openssl rand -base64 48
NEXTAUTH_SECRET=""

# Public site URL, used for JWT metadata and Open Graph
NEXTAUTH_URL="http://localhost:3000"
